# Run node tools/setup-local.mjs to generate private local configuration.
APP_ENV=development
PORT=3000
DB_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
DATABASE_URL=postgresql://tyre_demo:REPLACE_WITH_GENERATED_LOCAL_PASSWORD@127.0.0.1:55433/tyre_demo
JWT_SECRET=REPLACE_WITH_GENERATED_LOCAL_SECRET
DEMO_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://127.0.0.1:4200,http://127.0.0.1:4300
CHECKOUT_ENABLED=false
BOG_PAYMENTS_ENABLED=false
FITMENT_MOCK=true
IDENTITY_V2_ENABLED=false
CUSTOMER_MASTER_FOUNDATION_ENABLED=false
CUSTOMER_DATA_VAULT_FOUNDATION_ENABLED=false
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=59100
MINIO_USE_SSL=false
MINIO_BUCKET=tyre-photos
MINIO_ACCESS_KEY=tyre_demo
MINIO_SECRET_KEY=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
PHOTO_BASE_URL=http://127.0.0.1:59100/tyre-photos
