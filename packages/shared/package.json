      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tyre/admin-api-client": "0.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
