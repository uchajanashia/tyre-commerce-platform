{
  "name": "@tyre/shared",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist/**/*.js",
    "!dist/**/*.spec.js"
  ],
  "exports": {
    ".": {
