  partitionKey               String?
  ownerDomain                String
  producerId                 String
  producerAction             String?
  consumerId                 String?
  published                  Boolean         @default(false)
  enqueueEnabled             Boolean         @default(false)
  handlerEnabled             Boolean         @default(false)
  externalEffectCapable      Boolean         @default(false)
  safeFieldSchema            Json
  authorizationScopeKind     String
  scopeMatchMode             String
  requiredGlobalGrant        String?
