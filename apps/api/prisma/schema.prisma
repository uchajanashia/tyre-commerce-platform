  job                     BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  audit                   AuditEventV2  @relation(fields: [originatingAuditEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([state, createdAt, jobId], map: "JobReconciliation_state_idx")
}

model JobAuditLink {
  jobId        String        @db.Uuid
  auditEventId String        @unique
  operation    String
  createdAt    DateTime      @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  audit        AuditEventV2  @relation(fields: [auditEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  job          BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([jobId, auditEventId])
}

model JobFenceLossAudit {
  attemptStartedId String            @db.Uuid
  leaseGeneration  Int
  operation        String
  auditEventId     String            @unique
  createdAt        DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  runtimeLogin     String?
  attempt          JobAttemptStarted @relation(fields: [attemptStartedId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  audit            AuditEventV2      @relation(fields: [auditEventId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([attemptStartedId, leaseGeneration, operation])
}

model JobLeaseDigestKey {
  keyId       String                       @id
  keyMaterial Bytes
  notBefore   DateTime                     @db.Timestamptz(6)
  expiresAt   DateTime                     @db.Timestamptz(6)
  createdAt   DateTime                     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  revocation  JobLeaseDigestKeyRevocation?
}

model JobLeaseDigestKeyRevocation {
  keyId      String            @id
  revokedAt  DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  reasonCode String
  key        JobLeaseDigestKey @relation(fields: [keyId], references: [keyId], onDelete: Restrict, onUpdate: NoAction)
}

model JobRuntimeContextKey {
  keyId                   String                          @id
  purpose                 String                          @unique
  keyMaterial             Bytes
  notBefore               DateTime                        @db.Timestamptz(6)
  expiresAt               DateTime                        @db.Timestamptz(6)
  maxContextTtlSeconds    Int
  runtimeContractDigest   String
  registryDigest          String
  operationalPolicyDigest String
  runtimeLogin            String?
  principalId             String?
  boundaryDigest          String?
  createdAt               DateTime                        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  revocation              JobRuntimeContextKeyRevocation?
}

model JobOperationalPolicy {
  operationalPolicyDigest     String   @id
  maxAttemptsPerJob           Int
  maxHeartbeatsPerJob         Int
  maxReconciliationsPerJob    Int
  maxFenceLossPerMinute       Int
  maxAttemptsPerMinute        Int
  maxHeartbeatsPerMinute      Int
  maxReconciliationsPerMinute Int
  maxFactsPerMinute           Int
  maxAuditsPerMinute          Int
  maxFactsPerOrigin           Int
  maxAuditsPerOrigin          Int
  policyDocument              Json?
  queueCapacity               Int?
  partitionCapacity           Int?
  topicCapacity               Int?
  rootCapacity                Int?
  enqueueRatePerMinute        Int?
  claimRatePerMinute          Int?
  maxActiveLeases             Int?
  circuitFailureThreshold     Int?
  circuitOpenSeconds          Int?
  createdAt                   DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
}

model JobCapacityReservation {
  jobId                   String    @id @db.Uuid
  operationalPolicyDigest String
  partitionKey            String
  jobType                 String
  schemaVersion           Int
  originJobId             String    @db.Uuid
  isRoot                  Boolean
  state                   String
  leaseExpiresAt          DateTime? @db.Timestamptz(6)
  createdAt               DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  releasedAt              DateTime? @db.Timestamptz(6)

  @@index([operationalPolicyDigest, state, leaseExpiresAt], map: "JobCapacityReservation_global_idx")
  @@index([operationalPolicyDigest, partitionKey, state], map: "JobCapacityReservation_partition_idx")
  @@index([operationalPolicyDigest, jobType, schemaVersion, state], map: "JobCapacityReservation_topic_idx")
  @@index([operationalPolicyDigest, originJobId, state], map: "JobCapacityReservation_origin_idx")
}

model JobGlobalRateBucket {
  operationalPolicyDigest String
  minuteBucket            DateTime @db.Timestamptz(6)
  enqueueCount            Int      @default(0)
  claimCount              Int      @default(0)

  @@id([operationalPolicyDigest, minuteBucket])
}

model JobCircuitState {
  operationalPolicyDigest String
  jobType                 String
  schemaVersion           Int
  consecutiveFailures     Int       @default(0)
  openUntil               DateTime? @db.Timestamptz(6)
  updatedAt               DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@id([operationalPolicyDigest, jobType, schemaVersion])
}

model JobOriginRateBucket {
  originJobId         String   @db.Uuid
  minuteBucket        DateTime @db.Timestamptz(6)
  attemptCount        Int
  heartbeatCount      Int
  reconciliationCount Int
  fenceLossCount      Int
  factCount           Int
  auditCount          Int

  @@id([originJobId, minuteBucket])
}

model JobRuntimeContextKeyRevocation {
  keyId      String               @id
  revokedAt  DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  reasonCode String
  key        JobRuntimeContextKey @relation(fields: [keyId], references: [keyId], onDelete: Restrict, onUpdate: NoAction)
}

/// Phase C0 policy-neutral CRM identity boundary. This model intentionally has
/// no profile, contact, lifecycle, ownership, metadata, or external-ID fields.
/// Its database trigger owns all four values and the application has no table
/// privileges or callable customer surface in C0.
model CustomerMaster {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version   BigInt   @default(1)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
}

/// Provider-independent order aggregate. No public checkout endpoint is exposed
/// until the payment provider is configured and explicitly enabled.
model Order {
  fulfillmentStatus String @default("unallocated")
  reservationExpiresAt DateTime?
  operationsNextCheckAt DateTime?
  refundedMinor BigInt @default(0)
  customerId String?
  customer CommerceCustomer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reservations StockReservation[]
  refunds RefundRequest[]
  deliveryMethod String?
  customerEncrypted String?
  receiptPdfEncrypted String?
  notificationStatus String @default("not_ready")
  notificationAttempts Int @default(0)
  notificationNextAt DateTime?
  notificationLease String?
  id             String      @id @default(cuid())
  publicToken    String      @unique
  idempotencyKey String      @unique
  requestHash    String
  status         OrderStatus @default(draft)
  currency       String      @default("GEL")
  subtotal       Int
  total          Int
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items           OrderItem[]
  paymentAttempts PaymentAttempt[]

  @@index([status, createdAt])
  @@index([notificationStatus, notificationNextAt], map: "Order_notification_retry")
  @@index([operationsNextCheckAt])
  @@index([reservationExpiresAt])
  @@index([customerId, createdAt])
}

/// Immutable commercial snapshot. productId may become null if a catalog row is
/// later deleted; the SKU/name/price snapshot remains part of the order record.
model OrderItem {
  issuedQty Int @default(0)
  returnedQty Int @default(0)
  reservation StockReservation?
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  productCode String
  productName String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/// One provider initialization/retry. Provider-specific response bodies and
/// secrets are deliberately not stored here.
model PaymentAttempt {
  redirectUrl String?
  id                String               @id @default(cuid())
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String
  provider          String
  /// hosted, google_pay_external or apple_pay_external. Wallet payloads are never stored.
  method            String               @default("hosted")
  idempotencyKey    String               @unique
  /// Separate durable key for Apple Pay's completion request.
  completionIdempotencyKey String?        @unique
  providerReference String?
  status            PaymentAttemptStatus @default(created)
  failureCode       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  completedAt       DateTime?

  events PaymentEvent[]

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
}

/// Internal commerce profile; contact plaintext remains encrypted on the order.
model CommerceCustomer {
  id String @id @default(uuid())
  identityKey String @unique
  emailKey String
  phoneKey String
  createdAt DateTime @default(now())
  orders Order[]
  @@index([emailKey])
  @@index([phoneKey])
}

model StockReservation {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId String @unique
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity Int
  state String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, state])
}

/// Append-only inventory journal; physical and reserved quantities are separate.
model StockMovement {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId String?
  kind String
  onHandDelta Int
  reservedDelta Int
  onHandAfter Int
  reservedAfter Int
  actorId String?
  reason String?
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
  @@index([orderId, createdAt])
}

model OperationsCommand {
  id String @id
  fingerprint String
  result Json
  createdAt DateTime @default(now())
}

model RefundRequest {
  id String @id
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountMinor BigInt
  reason String
  actorId String
  state String @default("queued")
  providerReference String
  providerActionId String? @unique
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state, nextAttemptAt])
  @@index([orderId, createdAt])
}

/// Minimal callback audit/dedup record. Raw payment payloads are not persisted;
/// only a digest is retained until the official provider contract is known.
model PaymentEvent {
  id               String         @id @default(cuid())
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  paymentAttemptId String
  deduplicationKey String         @unique
  eventType        String
  payloadHash      String
  verified         Boolean        @default(false)
  receivedAt       DateTime       @default(now())

  @@index([paymentAttemptId, receivedAt])
}

/// Cache of the Wheel-Size API's /makes/ list. Vehicle makes essentially never
/// change, so this (and the two models below) is a TTL-refreshed cache in front
/// of the external API, not a source of truth we maintain by hand.
model VehicleMake {
  id             String         @id @default(cuid())
  /// Wheel-Size's make slug, e.g. "bmw" — the external identifier we cache by.
  slug           String         @unique
  name           String
  /// Null until /makes/{make}/models/ has been fetched at least once for this make.
  modelsCachedAt DateTime?
  cachedAt       DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  models         VehicleModel[]
}

/// Cache of the Wheel-Size API's /makes/{make}/models/ list, plus that model's
/// available years (fetched lazily from /makes/{make}/models/{model}/years/).
model VehicleModel {
  id            String      @id @default(cuid())
  make          VehicleMake @relation(fields: [makeId], references: [id], onDelete: Cascade)
  makeId        String
  /// Wheel-Size's model slug, unique within the make.
  slug          String
  name          String
  /// Available model years, e.g. [2019, 2020, 2021]. Empty until fetched.
  years         Int[]
  /// Null until the years endpoint has been fetched at least once for this model.
  yearsCachedAt DateTime?
  cachedAt      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([makeId, slug])
}

/// Cache of one Wheel-Size /search/by_model/ call (make + model + year), which
/// returns every trim/modification for that combination in one response — so
/// caching is keyed at that granularity, not per trim.
model VehicleFitment {
  id        String   @id @default(cuid())
  makeSlug  String
  modelSlug String
  year      Int
  /// Normalized array of { trimName, rimDiametersInch, oemBySize, staggered,
  /// minLoadIndex, oemSpeedRating } — see fitment/wheel-size-client.service.ts.
  payload   Json
  cachedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([makeSlug, modelSlug, year])
}
