  @@index([causationId, createdAt, id], map: "BackgroundJob_causation_idx")
  @@index([state, priority(sort: Desc), availableAt, id], map: "BackgroundJob_claim_idx")
  @@index([serverCorrelationId, createdAt, id], map: "BackgroundJob_correlation_idx")
  @@index([state, leaseExpiresAt, leaseGeneration], map: "BackgroundJob_lease_idx")
  @@index([originJobId, parentJobId, depth], map: "BackgroundJob_origin_idx")
  @@index([ownerDomain, createdAt, id], map: "BackgroundJob_owner_idx")
}

model JobAuthorizationScopeRef {
