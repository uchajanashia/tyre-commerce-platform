  jobHeartbeatFacts          JobHeartbeatFact[]
  jobReconciliations         JobReconciliation[]
  outboxConsumerReceipts     OutboxConsumerReceipt[]
  outboxAcknowledgements     OutboxAcknowledgement[]
  outboxMessages             OutboxMessage[]

  @@index([occurredAt, id])
  @@index([eventType, occurredAt, id])
  @@index([outcome, occurredAt, id])
  @@index([actorId, occurredAt, id])
  @@index([entityType, entityId, occurredAt, id])
  @@index([approvalRequestId, occurredAt, id])
  @@index([approvalExecutionId, occurredAt, id])
  @@index([bulkOperationId, bulkItemId, occurredAt, id])
  @@index([serverCorrelationId, occurredAt, id])
  @@index([causationId, occurredAt, id])
  @@index([source, occurredAt, id])
  @@index([retentionClass, occurredAt, id])
}

/// Canonical event-time scope tuples. They are normalized/indexed rather than
