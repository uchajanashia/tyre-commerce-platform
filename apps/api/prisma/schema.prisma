model BackgroundJob {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxMessageId            String                     @unique @db.Uuid
  jobType                    String
  schemaVersion              Int
  registryDigest             String
  ownerDomain                String
  safeSummary                Json
  inputDigest                String
  originJobId                String                     @db.Uuid
  parentJobId                String?                    @db.Uuid
  depth                      Int
  ancestryDigest             String
  authorizationScopeKind     String
  scopeMatchMode             String
  requiredGlobalGrant        String?
  scopeResolverId            String
  scopeResolverVersion       Int
  authorizationPolicyVersion Int
  state                      String                     @default("queued")
  priority                   Int
  availableAt                DateTime                   @db.Timestamptz(6)
  leaseGeneration            Int                        @default(0)
  leaseSecretDigest          Bytes?
  leaseDigestKeyId           String?
  leaseExpiresAt             DateTime?                  @db.Timestamptz(6)
  serverCorrelationId        String
  causationId                String?
  originatingAuditEventId    String
  createdAt                  DateTime                   @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  audit                      AuditEventV2               @relation(fields: [originatingAuditEventId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "BackgroundJob_audit_fkey")
  outbox                     OutboxMessage              @relation(fields: [outboxMessageId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "BackgroundJob_outbox_fkey")
  registry                   JobTypeRegistry            @relation(fields: [jobType, schemaVersion, registryDigest], references: [jobType, schemaVersion, registryDigest], onDelete: Restrict, onUpdate: NoAction, map: "BackgroundJob_registry_fkey")
  deadLetter                 DeadLetterAdmission?
